generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("postgresql://postgres.izgfnqndgzinfmtskzbe:Tuka@1803@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres")
  directUrl = env("postgresql://postgres.izgfnqndgzinfmtskzbe:Tuka@1803@aws-1-ap-southeast-2.pooler.supabase.com:5432/postgres")
}

model Photo {
  id        String    @id @default(cuid())
  imageData String    @db.Text
  createdAt DateTime  @default(now())
  comments  Comment[]
}

model Comment {
  id        String   @id @default(cuid())
  content   String
  createdAt DateTime @default(now())
  photoId   String
  photo     Photo    @relation(fields: [photoId], references: [id])
}